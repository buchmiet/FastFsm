<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="LocalFastFsm" value="./nuget" />
    <add key="LocalBaGet" value="http://localhost:5555/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <add key="allowInsecureConnections" value="True" />
  </config>
</configuration>