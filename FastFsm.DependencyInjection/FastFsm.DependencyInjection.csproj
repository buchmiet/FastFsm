<?xml version='1.0' encoding='utf-8'?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>

		<PackageId>FastFsm.Net.DependencyInjection</PackageId>
		<Authors>Lukasz Buchmiet</Authors>
		<Description>Dependency Injection support for FastFsm.Net state machines. Includes logging support.</Description>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageOutputPath>../nuget</PackageOutputPath>
		<IncludeBuildOutput>false</IncludeBuildOutput>

		
		<FsmGenerateDI>true</FsmGenerateDI>
		<FsmGenerateLogging>true</FsmGenerateLogging>
		<DefineConstants>$(DefineConstants);FSM_DI_ENABLED</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FastFsm.Net" Version="0.0.1.38-feature-fluent-hsm-parser-v0.7.5" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.7" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.7" />
	</ItemGroup>

	<ItemGroup>
		<None Include="build\FastFsm.Net.DependencyInjection.props" Pack="true" PackagePath="buildTransitive" />
	</ItemGroup>


	<ItemGroup>

		
		<None Include="..\FastFsm\Runtime\Extensions\ExtensionRunner.cs" Pack="true" PackagePath="contentFiles/cs/any" BuildAction="Compile" Visible="false" />


		
		<None Include="..\FastFsm\DependencyInjection\FsmServiceCollectionExtensions.cs" Pack="true" PackagePath="contentFiles/cs/any" BuildAction="Compile" Visible="false" />

	

		
		<None Include="..\FastFsm\DependencyInjection\StateMachineFactory.cs" Pack="true" PackagePath="contentFiles/cs/any" BuildAction="Compile" Visible="false" />

		


	</ItemGroup>

	
	<Target Name="StampVersionForNupkg" BeforeTargets="GenerateNuspec">
		<PropertyGroup>
			<Version>0.0.1.38-feature-fluent-hsm-parser-v0.7.5</Version>
			<PackageVersion>$(Version)</PackageVersion>
		</PropertyGroup>
	</Target>



	
</Project>