<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<FastFsmReferenceCore>true</FastFsmReferenceCore>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>

		<PackageId>FastFsm.Net.DependencyInjection</PackageId>
		<Authors>Lukasz Buchmiet</Authors>
		<Description>Dependency Injection support for FastFsm.Net state machines. Includes logging support.</Description>
		<PackageReleaseNotes>.NET 10 DI package for FastFsm.Net. Extension generation remains opt-in. See CHANGELOG.md.</PackageReleaseNotes>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IsPackable>true</IsPackable>
		<PackageOutputPath>../nuget</PackageOutputPath>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>

		
		<FsmGenerateDI>true</FsmGenerateDI>
		<FsmGenerateLogging>true</FsmGenerateLogging>
		<DefineConstants>$(DefineConstants);FSM_DI_ENABLED</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<None Include="build\FastFsm.Net.DependencyInjection.props" Pack="true" PackagePath="buildTransitive" />
		<None Include="..\docs\dependency-injection.md" Pack="true" PackagePath="README.md" />
	</ItemGroup>


	<ItemGroup>

		


		
		<None Include="..\FastFsm\DependencyInjection\FsmServiceCollectionExtensions.cs" Pack="true" PackagePath="contentFiles/cs/any" BuildAction="Compile" Visible="false" />

	

		
		<None Include="..\FastFsm\DependencyInjection\StateMachineFactory.cs" Pack="true" PackagePath="contentFiles/cs/any" BuildAction="Compile" Visible="false" />

		


	</ItemGroup>

	
	<Target Name="StampVersionForNupkg" BeforeTargets="GenerateNuspec">
		<PropertyGroup>
			<Version>$(FastFsmPackageVersion)</Version>
			<PackageVersion>$(Version)</PackageVersion>
		</PropertyGroup>
	</Target>



	
</Project>