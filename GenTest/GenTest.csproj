<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- AOT disabled for hot-reload support -->
    <PublishAot>false</PublishAot>
    <!-- Standard globalization settings -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude test files from compilation -->
    <Compile Remove="test_*.cs" />
    <None Include="test_*.cs" />
    <!-- Exclude previous generated outputs from compilation -->
    <Compile Remove="output_lifecycle/**/*.*" />
    <Compile Remove="output_lifecycle.bak/**/*.*" />
    <Compile Remove="output_tmp/**/*.*" />
    <None Include="output_*/**/*.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.7" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

</Project>
