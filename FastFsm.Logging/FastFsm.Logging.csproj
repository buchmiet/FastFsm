<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

	
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<FastFsmReferenceCore>true</FastFsmReferenceCore>

		<PackageId>FastFsm.Net.Logging</PackageId>
		<Authors>Lukasz Buchmiet</Authors>
		<Description>Enables logging for FastFsm.Net state machines</Description>

		<Deterministic>true</Deterministic>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageOutputPath>../nuget</PackageOutputPath>
		
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>

		
		<FsmGenerateLogging>true</FsmGenerateLogging>
		<DefineConstants>$(DefineConstants);FSM_LOGGING_ENABLED</DefineConstants>

		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>


		
		<PackageId>FastFsm.Net.Logging</PackageId>
		<Authors>Lukasz Buchmiet</Authors>
		<Description>High-performance state machine using source generators with support for ILogger</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/buchmiet/FastFsm</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/buchmiet/FastFsm</PackageProjectUrl>
		<PackageTags>fsm;state machine;source generator;roslyn;dotnet</PackageTags>
	</PropertyGroup>

	
		<ItemGroup>
			<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
		</ItemGroup>

	
	<ItemGroup>
		<None Include="build\FastFsm.Net.Logging.props" Pack="true" PackagePath="build" />
		<None Include="build\FastFsm.Net.Logging.props" Pack="true" PackagePath="buildTransitive" />
	</ItemGroup>

	
		<ItemGroup>
		  <None Include="shared/Compatibility.FastFsm.Extensions.cs" Pack="true" PackagePath="contentFiles/cs/any" BuildAction="Compile" Visible="false" />
		  <None Include="shared/Compatibility.FastFsm.Extensions.cs" Pack="true" PackagePath="build" BuildAction="Compile" Visible="false" />
		  <Folder Include="shared\" />
		</ItemGroup>

		<Target Name="StampVersionForNupkg" BeforeTargets="GenerateNuspec">
			<PropertyGroup>
				<Version>$(FastFsmPackageVersion)</Version>
				<PackageVersion>$(Version)</PackageVersion>
			</PropertyGroup>
		</Target>


</Project>