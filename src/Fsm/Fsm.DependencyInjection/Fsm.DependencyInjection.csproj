<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<FastFsmReferenceCore>true</FastFsmReferenceCore>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<Deterministic>true</Deterministic>

		<PackageId>FastFsm.DependencyInjection.Sharp</PackageId>
		<Description>Dependency injection support for FastFsm.Sharp state machines. Enables logging generation.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>.NET 10 DI package for FastFsm.Sharp. Depends on FastFsm.Sharp. Extension generation remains opt-in. See CHANGELOG.md.</PackageReleaseNotes>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<IsPackable>true</IsPackable>
		<PackageOutputPath>../../../nuget</PackageOutputPath>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<!-- Content-only package still declares dependencies; NU5128 is expected without lib/. -->
		<NoWarn>$(NoWarn);NU5128</NoWarn>

		<FsmGenerateDI>true</FsmGenerateDI>
		<FsmGenerateLogging>true</FsmGenerateLogging>
		<DefineConstants>$(DefineConstants);FSM_DI_ENABLED</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<None Include="build\FastFsm.DependencyInjection.Sharp.props" Pack="true" PackagePath="buildTransitive" />
		<None Include="..\..\..\docs\dependency-injection.md" Pack="true" PackagePath="README.md" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Fsm.Core\DependencyInjection\FsmServiceCollectionExtensions.cs" Pack="true" PackagePath="contentFiles/cs/any" BuildAction="Compile" Visible="false" />
		<None Include="..\Fsm.Core\DependencyInjection\StateMachineFactory.cs" Pack="true" PackagePath="contentFiles/cs/any" BuildAction="Compile" Visible="false" />
	</ItemGroup>
</Project>
