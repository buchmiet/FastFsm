<Project>
  <PropertyGroup>
    <FsmGenerateDI>true</FsmGenerateDI>
    <FsmGenerateLogging>true</FsmGenerateLogging>
    <DefineConstants>$(DefineConstants);FSM_DI_ENABLED;FSM_LOGGING_ENABLED</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="FsmGenerateDI" />
    <CompilerVisibleProperty Include="FsmGenerateLogging" />
  </ItemGroup>
</Project>