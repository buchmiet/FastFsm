<Project>
  <!-- ExtensionRunner.cs is packed as contentFiles (BuildAction=Compile). Do not Compile-include it here. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Reference Include="Abstractions">
      <HintPath>$(MSBuildThisFileDirectory)../lib/net10.0/Abstractions.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
